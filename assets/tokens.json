{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Pulli design tokens. Three layers: palette, primitive, semantic. Values are formulas where derived, so any consumer can re-resolve at a different pitch.",
  "seed": {
    "p": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Pulli pitch — the lattice spacing. The one number that moves."
    },
    "r": {
      "$value": "{seed.p} / 2",
      "$type": "dimension",
      "$description": "Loop radius. Locked to P by the meeting condition; forks may not change this relationship."
    }
  },
  "palette": {
    "maa": {
      "0": {
        "$value": "#FFFFFF"
      },
      "50": {
        "$value": "#FDFBF7"
      },
      "100": {
        "$value": "#F5EFE4"
      },
      "200": {
        "$value": "#E6DCC9"
      },
      "350": {
        "$value": "#BFB299"
      }
    },
    "mann": {
      "300": {
        "$value": "#998A75"
      },
      "350": {
        "$value": "#94836F"
      },
      "400": {
        "$value": "#7C6B5C"
      },
      "500": {
        "$value": "#786249"
      },
      "550": {
        "$value": "#5C4E42"
      },
      "700": {
        "$value": "#3A2E23"
      },
      "800": {
        "$value": "#2E241B"
      },
      "850": {
        "$value": "#211A14"
      },
      "900": {
        "$value": "#17120E"
      }
    },
    "kavi": {
      "100": {
        "$value": "#F6E4DA"
      },
      "300": {
        "$value": "#F3AE8B"
      },
      "400": {
        "$value": "#E7936A"
      },
      "600": {
        "$value": "#A34524"
      },
      "700": {
        "$value": "#7E331A"
      },
      "900": {
        "$value": "#33221A"
      }
    },
    "ilai": {
      "400": {
        "$value": "#74B682"
      },
      "600": {
        "$value": "#3D7049"
      }
    },
    "manjal": {
      "400": {
        "$value": "#F0BE5C"
      },
      "600": {
        "$value": "#8A6410"
      }
    },
    "neelam": {
      "400": {
        "$value": "#8CA8E0"
      },
      "600": {
        "$value": "#33509B"
      }
    },
    "kumkumam": {
      "400": {
        "$value": "#E58484"
      },
      "600": {
        "$value": "#A32626"
      }
    }
  },
  "primitive": {
    "idai": {
      "$description": "Spacing — orthogonal lattice steps. No half-steps.",
      "1": {
        "$value": "{seed.p} * 1",
        "$type": "dimension"
      },
      "2": {
        "$value": "{seed.p} * 2",
        "$type": "dimension"
      },
      "3": {
        "$value": "{seed.p} * 3",
        "$type": "dimension"
      },
      "4": {
        "$value": "{seed.p} * 4",
        "$type": "dimension"
      },
      "5": {
        "$value": "{seed.p} * 5",
        "$type": "dimension"
      },
      "6": {
        "$value": "{seed.p} * 6",
        "$type": "dimension"
      },
      "8": {
        "$value": "{seed.p} * 8",
        "$type": "dimension"
      },
      "10": {
        "$value": "{seed.p} * 10",
        "$type": "dimension"
      },
      "12": {
        "$value": "{seed.p} * 12",
        "$type": "dimension"
      },
      "16": {
        "$value": "{seed.p} * 16",
        "$type": "dimension"
      }
    },
    "valai": {
      "$description": "Radius — multiples of the loop radius.",
      "1": {
        "$value": "{seed.r} * 0.5",
        "$type": "dimension"
      },
      "2": {
        "$value": "{seed.r} * 1",
        "$type": "dimension"
      },
      "3": {
        "$value": "{seed.r} * 2",
        "$type": "dimension"
      },
      "4": {
        "$value": "{seed.r} * 4",
        "$type": "dimension"
      },
      "5": {
        "$value": "{seed.r} * 6",
        "$type": "dimension"
      },
      "full": {
        "$value": "999px",
        "$type": "dimension"
      }
    },
    "kambi": {
      "$description": "Stroke. kambi-1 is a literal pixel, not derived — see 'exceptions'.",
      "1": {
        "$value": "1px",
        "$type": "dimension"
      },
      "2": {
        "$value": "2px",
        "$type": "dimension"
      },
      "3": {
        "$value": "{seed.r}",
        "$type": "dimension"
      }
    },
    "alavu": {
      "$description": "Control heights. md and lg carry an absolute accessibility floor.",
      "xs": {
        "$value": "{seed.p} * 3",
        "$type": "dimension"
      },
      "sm": {
        "$value": "{seed.p} * 4",
        "$type": "dimension"
      },
      "md": {
        "$value": "max({seed.p} * 5.5, 44px)",
        "$type": "dimension"
      },
      "lg": {
        "$value": "max({seed.p} * 7, 48px)",
        "$type": "dimension"
      }
    },
    "ezhuthu": {
      "$description": "Type. Ratio √2 — the lattice diagonal. Does NOT scale with pitch.",
      "caption": {
        "$value": "11px",
        "$type": "dimension"
      },
      "small": {
        "$value": "13px",
        "$type": "dimension"
      },
      "body": {
        "$value": "16px",
        "$type": "dimension"
      },
      "lead": {
        "$value": "23px",
        "$type": "dimension"
      },
      "h2": {
        "$value": "32px",
        "$type": "dimension"
      },
      "h1": {
        "$value": "45px",
        "$type": "dimension"
      },
      "display": {
        "$value": "64px",
        "$type": "dimension"
      }
    },
    "nagarthal": {
      "$description": "Duration is distance — 30ms per dot traversed.",
      "1": {
        "$value": "120ms",
        "$type": "duration"
      },
      "2": {
        "$value": "240ms",
        "$type": "duration"
      },
      "3": {
        "$value": "360ms",
        "$type": "duration"
      },
      "4": {
        "$value": "600ms",
        "$type": "duration"
      }
    },
    "easing": {
      "neli": {
        "$value": [
          0.65,
          0,
          0.35,
          1
        ],
        "$type": "cubicBezier",
        "$description": "the turn — symmetric"
      },
      "chuzhi": {
        "$value": [
          0.33,
          0,
          0.15,
          1
        ],
        "$type": "cubicBezier",
        "$description": "the spiral in — settle"
      },
      "vidu": {
        "$value": [
          0.5,
          0,
          0.9,
          0.4
        ],
        "$type": "cubicBezier",
        "$description": "the release — exit"
      }
    }
  },
  "semantic": {
    "$description": "The public API. Product code may reference only this layer.",
    "space": {
      "inset-xs": {
        "$value": "{primitive.idai.1}"
      },
      "inset-sm": {
        "$value": "{primitive.idai.2}"
      },
      "inset-md": {
        "$value": "{primitive.idai.3}"
      },
      "inset-lg": {
        "$value": "{primitive.idai.4}"
      },
      "inset-xl": {
        "$value": "{primitive.idai.6}"
      },
      "stack-tight": {
        "$value": "{primitive.idai.1}"
      },
      "stack": {
        "$value": "{primitive.idai.2}"
      },
      "section": {
        "$value": "{primitive.idai.12}"
      },
      "inline": {
        "$value": "{primitive.idai.2}"
      },
      "gutter": {
        "$value": "{primitive.idai.3}"
      },
      "page-margin": {
        "$value": "{primitive.idai.4}"
      }
    },
    "radius": {
      "control": {
        "$value": "{primitive.valai.3}"
      },
      "surface": {
        "$value": "{primitive.valai.3}"
      },
      "panel": {
        "$value": "{primitive.valai.4}"
      },
      "pill": {
        "$value": "{primitive.valai.full}"
      }
    },
    "border": {
      "hairline": {
        "$value": "{primitive.kambi.1}"
      },
      "edge": {
        "$value": "{primitive.kambi.2}"
      }
    },
    "motion": {
      "state": {
        "$value": "{primitive.nagarthal.1} {primitive.easing.neli}"
      },
      "reveal": {
        "$value": "{primitive.nagarthal.2} {primitive.easing.chuzhi}"
      },
      "exit": {
        "$value": "{primitive.nagarthal.1} {primitive.easing.vidu}"
      },
      "page": {
        "$value": "{primitive.nagarthal.3} {primitive.easing.chuzhi}"
      }
    },
    "color": {
      "$description": "Two modes. Dark is the native theme; light is the inversion.",
      "bg": {
        "light": "{palette.maa.50}",
        "dark": "{palette.mann.900}"
      },
      "surface": {
        "light": "{palette.maa.0}",
        "dark": "{palette.mann.850}"
      },
      "surface-sunken": {
        "light": "{palette.maa.100}",
        "dark": "{palette.mann.800}"
      },
      "text": {
        "light": "{palette.mann.900}",
        "dark": "{palette.maa.100}",
        "contrast": {
          "light": 17.99,
          "dark": 16.25
        },
        "contrast-worst-surface": {
          "light": 16.25,
          "dark": 13.25
        }
      },
      "text-secondary": {
        "light": "{palette.mann.550}",
        "dark": "{palette.maa.350}",
        "contrast": {
          "light": 7.74,
          "dark": 8.89
        },
        "contrast-worst-surface": {
          "light": 6.99,
          "dark": 7.25
        }
      },
      "text-tertiary": {
        "light": "{palette.mann.500}",
        "dark": "{palette.mann.300}",
        "contrast": {
          "light": 5.58,
          "dark": 5.53
        },
        "$description": "Smallest margin in the system. Captions and metadata only; never essential information.",
        "contrast-worst-surface": {
          "light": 5.04,
          "dark": 4.51
        }
      },
      "border": {
        "light": "{palette.maa.200}",
        "dark": "{palette.mann.700}",
        "$description": "Decorative only — not held to 3:1."
      },
      "border-strong": {
        "light": "{palette.mann.350}",
        "dark": "{palette.mann.350}",
        "contrast": {
          "light": 3.54,
          "dark": 5.08
        },
        "$description": "Interactive control boundaries. Meets 3:1 non-text.",
        "contrast-worst-surface": {
          "light": 3.2,
          "dark": 4.14
        }
      },
      "accent": {
        "light": "{palette.kavi.600}",
        "dark": "{palette.kavi.400}",
        "contrast": {
          "light": 5.92,
          "dark": 7.77
        }
      },
      "accent-hover": {
        "light": "{palette.kavi.700}",
        "dark": "{palette.kavi.300}"
      },
      "accent-subtle": {
        "light": "{palette.kavi.100}",
        "dark": "{palette.kavi.900}"
      },
      "on-accent": {
        "light": "{palette.maa.50}",
        "dark": "{palette.mann.900}",
        "contrast": {
          "light": 5.92,
          "dark": 7.77
        },
        "$description": "Measured against --color-accent, not the page background."
      },
      "success": {
        "light": "{palette.ilai.600}",
        "dark": "{palette.ilai.400}",
        "contrast": {
          "light": 5.62,
          "dark": 7.75
        }
      },
      "warning": {
        "light": "{palette.manjal.600}",
        "dark": "{palette.manjal.400}",
        "contrast": {
          "light": 5.2,
          "dark": 10.83
        }
      },
      "info": {
        "light": "{palette.neelam.600}",
        "dark": "{palette.neelam.400}",
        "contrast": {
          "light": 7.36,
          "dark": 7.79
        }
      },
      "danger": {
        "light": "{palette.kumkumam.600}",
        "dark": "{palette.kumkumam.400}",
        "contrast": {
          "light": 7.1,
          "dark": 7.05
        }
      },
      "on-danger": {
        "light": "{palette.maa.50}",
        "dark": "{palette.maa.50}",
        "$description": "Added when the audit found product CSS reaching into the palette for it."
      },
      "scrim": {
        "light": "{palette.mann.900}",
        "dark": "{palette.mann.900}",
        "$description": "Added when the audit found product CSS reaching into the palette for it."
      }
    }
  },
  "density": {
    "$description": "One attribute re-derives the interface. Type is unaffected.",
    "compact": {
      "p": "6px"
    },
    "default": {
      "p": "8px"
    },
    "comfortable": {
      "p": "10px"
    }
  },
  "exceptions": {
    "$description": "The four places derivation deliberately does not apply. Adding to this list requires a decision record.",
    "target-size": {
      "governed-by": "WCAG 2.5.8",
      "rule": "Interactive controls floor at 44px via max(). At P=6 the derived height would be 33px."
    },
    "hairline": {
      "governed-by": "device pixels",
      "rule": "kambi-1 is a literal 1px. Sub-pixel borders render inconsistently."
    },
    "type-scale": {
      "governed-by": "the lattice diagonal, √2",
      "rule": "Type does not scale with pitch. Density changes space, not reading size."
    },
    "breakpoints": {
      "governed-by": "viewport and reading",
      "rule": "Breakpoints and measure are fixed. Chosen as lattice multiples at P=8, then frozen."
    }
  },
  "generator": {
    "$description": "Pattern assets are committed as parameters, not as files.",
    "unit": 40,
    "radius": "unit / 2",
    "defaults": {
      "dots": 7,
      "symmetry": "d4",
      "crossing": 0.2,
      "stroke": 3,
      "showDots": true,
      "seed": null
    },
    "guarantees": [
      "every path endpoint is shared by exactly two paths — no open ends",
      "d4 output is invariant under transpose and both mirrors",
      "every arc centre lies on a lattice dot",
      "identical output for identical seed, on every machine"
    ]
  }
}
